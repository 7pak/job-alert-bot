# Copy to deploy/.deploy.env (gitignored) and fill in. Environment variables win over this file.
JOBBOT_HOST=ubuntu@your-server-ip
JOBBOT_KEY=~/.ssh/id_ed25519
# JOBBOT_APP_DIR=/opt/job-alert-bot
# JOBBOT_SERVICE=job-alert-bot
# JOBBOT_USER=jobbot
# Extra pip packages for the server. Default: worked out from config.yml (CV tailoring needs the
# anthropic SDK and, for .docx, python-docx). "none" installs nothing extra.
# JOBBOT_EXTRAS=anthropic>=1.0 python-docx>=1.1
